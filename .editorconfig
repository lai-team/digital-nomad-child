root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# WordPress coding standards. PHP and CSS here are tab-indented; the JS under
# assets/js/ uses four spaces and has not been reformatted.
[*.{php,css}]
indent_style = tab

[*.js]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
